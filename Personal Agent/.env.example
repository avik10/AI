# ==============================================================================
# Environment Configuration Template for Personal AI Agent Studio
# Copy this file to .env and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Selector ('ollama' for local dev, 'groq' for 24/7 cloud deployment)
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# 2. Groq Cloud API (Recommended for 24/7 Cloud Deployment - Render / Railway / Fly.io)
# Get your free key at: https://console.groq.com/keys
# Available models:
#   - llama-3.3-70b-versatile  (Recommended: 128k context, high intelligence)
#   - llama-3.1-8b-instant     (Ultra-low latency, blazing fast)
#   - mixtral-8x7b-32768       (32k context, robust multi-task)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 3. Ollama Configuration (Local Mode on your computer)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen3.5:8b
TEMPERATURE=0.8

# ------------------------------------------------------------------------------
# 4. OpenWeatherMap API Configuration
# Get your free key at: https://home.openweathermap.org/api_keys
# ------------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ------------------------------------------------------------------------------
# 5. Google Keep MCP Server Configuration (Real Google Keep Data Access)
# Generate your 16-char App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# GOOGLE_KEEP_EMAIL=your-email@gmail.com
# GOOGLE_KEEP_APP_PASSWORD=your_16_character_app_password

# ------------------------------------------------------------------------------
# 6. Production Web & OAuth Configuration
# ------------------------------------------------------------------------------
# Frontend URL (for production OAuth redirects, e.g. on Netlify or Render)
# FRONTEND_URL=https://your-site.netlify.app
