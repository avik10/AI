# ==============================================================================
# Frontend Environment Variables (Netlify Deployment)
# ==============================================================================

# Backend API Base URL
# - If your backend is deployed on Render, Railway, Fly.io, or VPS, set its HTTPS URL here.
#   Example: VITE_API_BASE_URL=https://my-agent-backend.onrender.com
# - If you are using Netlify's reverse-proxy rule in netlify.toml (/api/*), you can leave this empty.
# - During local Vite development (npm run dev), defaults to http://localhost:8000 automatically.
VITE_API_BASE_URL=
